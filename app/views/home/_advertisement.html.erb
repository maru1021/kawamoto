<div class="section-inner">
  <div class="section-heading fade-in" id="parliament">
    <span class="section-heading-en">REPORT</span>
    <h2 class="section-heading-ja">議会報告</h2>
    <div class="section-heading-line"></div>
  </div>

  <div class="carousel fade-in">
    <button class="carousel-btn carousel-btn--prev is-hidden" id="prev" aria-label="前へ">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="carousel-track-wrapper">
      <div class="advertisement">
        <% @pdf_thumbnails.each_with_index do |thumbnail_path, i|
          filename = File.basename(thumbnail_path, '_page_1.png')
          match = filename.match(/^(\d{4})-(\d+)No(\d+)/)
          alt_text = match ? "議会報告 #{match[1]}年#{match[2]}月号 No.#{match[3]}" : "議会報告PDF"
          src = "/advertisement/thumbnails/#{File.basename(thumbnail_path)}"
        %>
          <div class="advertisement-thumbnail">
            <% if i < 3 %>
              <%= link_to image_tag(src, alt: alt_text),
                  "/advertisement/#{filename}.pdf", target: '_blank', rel: 'noopener noreferrer' %>
            <% else %>
              <%= link_to tag.img(alt: alt_text, data: { src: src }, class: 'lazy-img'),
                  "/advertisement/#{filename}.pdf", target: '_blank', rel: 'noopener noreferrer' %>
            <% end %>
            <div class="carousel-hover-label">PDF を開く</div>
          </div>
        <% end %>
      </div>
    </div>

    <button class="carousel-btn carousel-btn--next" id="next" aria-label="次へ">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</div>
