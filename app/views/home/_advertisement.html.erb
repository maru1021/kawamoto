<div class="section-inner">
  <div class="section-heading fade-in" id="arliament">
    <span class="section-heading-en">REPORT</span>
    <h2 class="section-heading-ja">議会報告</h2>
    <div class="section-heading-line"></div>
  </div>

  <div class="carousel fade-in">
    <button class="carousel-btn carousel-btn--prev is-hidden" id="prev" aria-label="前へ">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="carousel-track-wrapper">
      <div class="advertisement">
        <% @pdf_thumbnails.each do |thumbnail_path| %>
          <div class="advertisement-thumbnail">
            <%= link_to image_tag("/advertisement/thumbnails/#{File.basename(thumbnail_path)}", alt: 'PDF Thumbnail'),
                "/advertisement/#{File.basename(thumbnail_path, '_page_1.png')}.pdf", target: '_blank'
            %>
            <div class="carousel-hover-label">PDF を開く</div>
          </div>
        <% end %>
      </div>
    </div>

    <button class="carousel-btn carousel-btn--next" id="next" aria-label="次へ">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</div>
