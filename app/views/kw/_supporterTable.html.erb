<div class="title-back">
  <div class="title">後援会名簿</div>
</div>

<div id="searchfield">
    <label for=search>検索</label>
    <input type="text" id="search">
</div>

<div id="supporter">
    <table id="supporterTable">
        <thead>
            <tr>
                <th>名前</th>
                <th>郵便番号</th>
                <th>住所</th>
                <th>電話番号</th>
                <th>生年月日</th>
            </tr>
        </thead>
        <tbody>
            <% @supporters.each do |supporter| %>
                <tr id="<%= supporter.id %>">
                    <td class="supporter-name"><%= supporter.name %></td>
                    <td class="supporter-post"><%= supporter.post %></td>
                    <td class="supporter-address"><%= supporter.address %></td>
                    <td class="supporter-phone"><%= supporter.phone %></td>
                    <td class="supporter-birth"><%= supporter.birth %></td>
                </tr>
                <% end %>
        </tbody>
    </table>
</div>