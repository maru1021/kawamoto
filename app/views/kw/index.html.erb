<div class="form-container">
    <form id="uploadForm" enctype="multipart/form-data">
        <div class="form-group">
            <label for="pdf">議会報告のPDFファイル</label>
            <input type="file" id="pdf" name="pdf" accept="application/pdf" class="form-control-file">
        </div>
        <button type="submit" class="btn btn-primary" id="uploadFormButton">アップロード</button>
    </form>
</div>

<%= render "supporterTable" %>

<div class="custom-context-menu" id="supporterContextMenu">
    <div id="supporterMenuEdit">編集</div>
    <div id="supporterMenuDelete">削除</div>
</div>

<%= render "home/supporterModal" %>
<%= render "notiModal" %>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
