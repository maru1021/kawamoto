<div class="modal fade" id="notiModal" tabindex="-1" aria-labelledby="notiModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="supporterModalLabel">お知らせ登録</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="notiForm">
          <input type="hidden" name="authenticity_token" value="" id="csrfTokenField">
          <div class="form-group">
                <label for="notiImage">画像</label>
                <input type="file" id="notiImage" name="image" accept="application/image/png,image/jpeg,image/gif" class="form-control-file">
                <div class="invalid-feedback">画像を選択してください</div>
            </div>
          <div class="form-group">
            <label for="notilTitle">タイトル</label>
            <input type="text" class="form-control" id="notiTitle" name="title">
            <div class="invalid-feedback">タイトルを入力してください</div>
          </div>
          <div class="form-group">
            <label for="notiArticle">本文</label>
            <textarea class="form-control" id="notiArticle" name="article" rows="15"></textarea>
            <div class="invalid-feedback">本文を入力してください</div>
          </div>
          <hr>
          <div class="d-flex justify-content-end">
              <button type="submit" id="notiSaveButton" class="btn btn-primary" data-type="">登録</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>